{% comment %}
  =============================================================================
  FAVORITE SECTION - PRODUCT FAVORITES WITH TOGGLE SYSTEM
  =============================================================================
  Interactive product favorites section with category-based filtering
  - Three-toggle system for organizing favorite products
  - Swiper.js carousel integration for product image galleries
  - Dynamic product filtering based on collection context
  - Alt tag priority system for collection-specific image display
  - Responsive carousel with pagination and lazy loading
  - Product information display with titles and pricing
{% endcomment %}

{% comment %}
  =============================================================================
  EXTERNAL CSS ASSET LOADING
  =============================================================================
  Loads dedicated CSS file for favorite section styling
  - favorite-section.css: Section-specific stylesheet
  - asset_url filter: Generates proper asset URL
  - stylesheet_tag: Renders as <link> tag for CSS loading
{% endcomment %}
{{ 'favorite-section.css' | asset_url | stylesheet_tag }}

{% comment %}
  =============================================================================
  MAIN FAVORITES CONTAINER
  =============================================================================
  Primary container for favorites section layout
  - favorites__container: Main wrapper for all favorites content
  - Contains title, toggle system, and product carousels
{% endcomment %}
<div class="favorites__container">
  {% comment %}
    =============================================================================
    SECTION TITLE
    =============================================================================
    Main heading for the favorites section
    - favorites__title: Title styling class
    - section.settings.title: Custom title from theme editor
  {% endcomment %}
  <h1 class="favorites__title">{{ section.settings.title }}</h1>

  {% comment %}
    =============================================================================
    TOGGLE SYSTEM CONTAINER
    =============================================================================
    Three-toggle system for switching between favorite categories
    - favorites__toggler-wrapper: Container for all toggle buttons
    - Three toggle buttons: left, center, right
    - Dynamic visibility based on toggle content availability
    - favorites__toggler-active: Currently active toggle state
  {% endcomment %}
  <div class="favorites__toggler-wrapper ">
   
    {% comment %}
      =============================================================================
      LEFT TOGGLE BUTTON
      =============================================================================
      First toggle button for category A favorites
      - favorites__toggler: Base toggle button styling
      - favorites__toggler-active: Active state styling
      - favorites__toggler-alone: Single toggle styling when others are empty
      - hidden-favorite__products: Hides when no content available
      - id="toggler-btn-left": Unique identifier for JavaScript interaction
    {% endcomment %}
    <div class="favorites__toggler favorites__toggler-active {% if section.settings.toggler-right == blank %} favorites__toggler-alone {% endif %} {% if section.settings.toggler-left == blank %} hidden-favorite__products {% endif %}"  id="toggler-btn-left">{{ section.settings.toggler-left }}</div>

    {% comment %}
      =============================================================================
      CENTER TOGGLE BUTTON
      =============================================================================
      Second toggle button for category B favorites
      - favorites__toggler: Base toggle button styling
      - favorites__toggler-alone: Single toggle styling when others are empty
      - hidden-favorite__products: Hides when no content available
      - id="toggler-btn-center": Unique identifier for JavaScript interaction
    {% endcomment %}
    <div class="favorites__toggler {% if section.settings.toggler-center == blank %} favorites__toggler-alone {% endif %} {% if section.settings.toggler-center == blank %} hidden-favorite__products {% endif %}" id="toggler-btn-center">{{ section.settings.toggler-center }}</div>

    {% comment %}
      =============================================================================
      RIGHT TOGGLE BUTTON
      =============================================================================
      Third toggle button for category C favorites
      - favorites__toggler: Base toggle button styling
      - favorites__toggler-alone: Single toggle styling when others are empty
      - hidden-favorite__products: Hides when no content available
      - id="toggler-btn-right": Unique identifier for JavaScript interaction
    {% endcomment %}
    <div class="favorites__toggler {% if section.settings.toggler-left == blank %} favorites__toggler-alone {% endif %} {% if section.settings.toggler-right == blank %} hidden-favorite__products {% endif %}" id="toggler-btn-right">{{ section.settings.toggler-right }}</div>
  </div>

  {% comment %}
    =============================================================================
    FAVORITES CONTENT CONTAINER
    =============================================================================
    Main content area containing product carousels
    - favorites__content-container: Wrapper for all product content
    - favorites-carousel-outer: Outer carousel container
    - swiper-wrapper: Swiper.js carousel wrapper
  {% endcomment %}
  <div class="favorites__content-container">
    <div class="favorites-carousel-outer">
      <div class="swiper-wrapper">
        {% comment %}
          =============================================================================
          FAVORITE CATEGORY A PRODUCTS
          =============================================================================
          First category of favorite products
          - section.blocks | where: 'type', 'favorite-a': Filters blocks by type
          - favorite-a: Block type for category A products
          - Loops through all category A favorite products
        {% endcomment %}
        {% assign favoritesA = section.blocks | where: 'type', 'favorite-a' %}
        {% for block in favoritesA %}
            {% comment %}
              =============================================================================
              PRODUCT DATA ASSIGNMENT
              =============================================================================
              Retrieves product information from block settings
              - all_products[block.settings.product]: Product lookup by handle
              - product_url: Product detail page URL
              - Used for linking and product information display
            {% endcomment %}
            {% assign product = all_products[block.settings.product] %}
            {% assign product_url = product.url %}

            {% comment %}
              =============================================================================
              FAVORITE PRODUCT CONTAINER
              =============================================================================
              Individual favorite product wrapper
              - favorites__content: Base product styling class
              - favorite-products-a: Category A specific styling
              - swiper-slide: Swiper.js slide class
              - hidden-favorite__products: Hidden when toggle is empty
            {% endcomment %}
            <div class="favorites__content favorite-products-a swiper-slide {% if section.settings.toggler-left == blank %} hidden-favorite__products {% endif %}">
              {% comment %}
                =============================================================================
                PRODUCT CAROUSEL CONTENT
                =============================================================================
                Carousel container for product image gallery
                - favorites-carousel-content: Carousel wrapper
                - swiper-wrapper: Swiper.js carousel wrapper
                - Contains product images with priority system
              {% endcomment %}
              <div class="favorites-carousel-content">
                <div class="swiper-wrapper">
                  {% comment %}
                    =============================================================================
                    PRODUCT IMAGE FILTERING
                    =============================================================================
                    Filters product media to show only images
                    - product.media: All product media (images, videos, 3D models)
                    - where: 'media_type', 'image': Filters to images only
                    - limit: 5: Maximum of 5 images per carousel
                  {% endcomment %}
                  {% assign product_only_images = product.media | where: 'media_type', 'image' %}

                  {% comment %}
                    =============================================================================
                    ALT TAG PRIORITY SYSTEM
                    =============================================================================
                    Complex logic for determining which image to show first
                    - collection_handle: Current collection context
                    - alt_tags: Splits alt text by pipe separator
                    - alt_colletions: Array for collection-specific tags
                    - images_index: Current image loop index
                    - has_alt_priority: Boolean for priority image found
                    - item_to_show: Selected image for priority display
                  {% endcomment %}
                  {% for itemImage in product_only_images limit: 5 %}
                    {% assign collection_handle = collection.handle %}
                    {% assign alt_tags = itemImage.alt | split: "|" %}
                    {% assign alt_colletions = "" | split: "" %}
                    {% assign images_index = forloop.index0 %}
                    {% assign has_alt_priority = false %}
                    {% assign item_to_show = itemImage %}

                    {% comment %}
                      =============================================================================
                      ALT TAG PARSING LOOP
                      =============================================================================
                      Processes alt text for collection-specific priority
                      - tags: Individual alt tag segments
                      - tag[0]: Tag name (e.g., "first")
                      - tag[1]: Tag value (comma-separated collection list)
                      - Checks if current collection matches priority collections
                    {% endcomment %}
                    {% for tags in alt_tags %}
                      {% assign tag = tags | split: ":" %}
                      {% assign tag_name = tag[0] | strip %}
                      {% if tag_name == "first" %}
                        {% assign alt_colletions = tag[1] | split: "," %}
                        {% for my_tag in alt_colletions %}
                          {% assign actual_tag = "" %}
                          {% assign actual_tag = my_tag | strip %}
                          {% if collection_handle != actual_tag %}
                            {% assign first_image = images_index %}
                            {% assign has_alt_priority = true %}
                            {% assign item_to_show = itemImage %}
                            {% break %}
                          {% endif %}
                        {% endfor %}
                        {% if has_alt_priority %}
                          {% break %}
                        {% endif %}
                      {% endif %}
                    {% endfor %}
        
                    {% comment %}
                      =============================================================================
                      PRIORITY IMAGE BREAK
                      =============================================================================
                      Exits loop when priority image is found
                      - has_alt_priority: Boolean indicating priority found
                      - item_to_show: Selected priority image
                      - first_image: Index of priority image
                    {% endcomment %}
                    {% if has_alt_priority %}
                      {% break %}
                    {% endif %}
                  {% endfor %}

                  {% comment %}
                    =============================================================================
                    PRIORITY IMAGE DISPLAY
                    =============================================================================
                    Shows the priority image first if one was found
                    - has_alt_priority: Boolean for priority image availability
                    - forloop.index0 <= 4: Ensures image is within limit
                    - item_to_show: Priority image for display
                    - tabindex="-1": Removes from tab order (mouse-only interaction)
                  {% endcomment %}
                  {% if has_alt_priority %}
                    <div class="swiper-slide">
                      {% if forloop.index0 <= 4 %}
                        <a href="{{ product_url }}" aria-label="{{ product.title | escape }}" tabindex="-1">
                          {{ item_to_show | image_url: width: 600 | image_tag: class: 'swiper-slide-image favorites__image', loading: 'lazy' }}
                        </a>
                      {% else %}
                        <a href="{{ product_url }}" aria-label="{{ product.title | escape }}" tabindex="-1">
                          {{ item_to_show | image_url: width: 600 | image_tag: class: 'swiper-slide-image favorites__image', loading: 'lazy' }}
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}          
        
                  {% comment %}
                    =============================================================================
                    REMAINING PRODUCT IMAGES
                    =============================================================================
                    Displays remaining product images in carousel
                    - Skips priority image if already displayed
                    - forloop.index0 == first_image: Checks for priority image
                    - has_alt_priority: Only skips if priority system is active
                    - continue: Skips to next iteration when priority image found
                  {% endcomment %}
                  {% for itemImage in product_only_images limit: 5 %}
                    {% if forloop.index0 == first_image and has_alt_priority %}
                      {% continue %}
                    {% endif %}
                  <div class="swiper-slide">
                    {% if forloop.index0 <= 4 %}
                      <a href="{{ product_url }}" aria-label="{{ product.title | escape }}" tabindex="-1">
                        {{ itemImage | image_url: width: 600 | image_tag: class: 'swiper-slide-image favorites__image', loading: 'lazy' }}
                      </a>
                    {% else %}
                      <a href="{{ product_url }}" aria-label="{{ product.title | escape }}" tabindex="-1">
                        {{ itemImage | image_url: width: 600 | image_tag: class: 'swiper-slide-image favorites__image', loading: 'lazy' }}
                      </a>
                    {% endif %}
                  </div>
                {% endfor %}
                </div>

                {% comment %}
                  =============================================================================
                  CAROUSEL PAGINATION
                  =============================================================================
                  Swiper.js pagination dots for carousel navigation
                  - swiper-pagination: Pagination container class
                  - Automatically generated by Swiper.js
                  - Shows current slide position and total slides
                {% endcomment %}
              <div class="swiper-pagination"></div>
            </div>

            {% comment %}
              =============================================================================
              PRODUCT INFORMATION
              =============================================================================
              Product title and pricing display
              - favorites__product-title: Product name styling
              - favorites__product-price: Price styling
              - product.title: Product title from Shopify
              - product.price: Product price with money formatting
              - money_without_trailing_zeros: Removes unnecessary decimal places
            {% endcomment %}
            <p class="favorites__product-title">{{ product.title }}</p>
            <p class="favorites__product-price">{{ product.price | money_without_trailing_zeros }}</p>
          </div>
