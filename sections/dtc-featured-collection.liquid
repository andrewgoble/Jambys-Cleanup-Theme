{% comment %}
  =============================================================================
  DTC FEATURED COLLECTION SECTION - ADVANCED PRODUCT DISPLAY SYSTEM
  =============================================================================
  Advanced featured collection section with multiple layout options and customization
  - External CSS loading for upsell feature styling
  - Dynamic CSS generation for title alignment and background colors
  - Wave divider integration with customizable positioning and colors
  - Multiple layout options: rows, columns, and carousel
  - Responsive grid system with configurable product counts
  - Animation controls with different entrance effects
  - Related products metafield integration
  - Carousel functionality with Swiper.js integration
  - Used for DTC Pages CRO group's product display testing
{% endcomment %}

{% comment %}
  =============================================================================
  EXTERNAL CSS ASSET LOADING
  =============================================================================
  Loads dedicated CSS file for DTC upsell feature styling
  - dtc-upsell-feature.css: Section-specific stylesheet
  - asset_url filter: Generates proper asset URL
  - stylesheet_tag: Renders as <link> tag for CSS loading
{% endcomment %}
{{ 'dtc-upsell-feature.css' | asset_url | stylesheet_tag }}

{% comment %}
  =============================================================================
  DYNAMIC TITLE ALIGNMENT CSS
  =============================================================================
  Generates CSS for title alignment based on theme editor setting
  - section.settings.title_alignment: Alignment option from theme editor
  - 'center': Centers title and section heading
  - section-id-{{ section.id }}: Section-specific CSS targeting
  - flex-wrap, align-items, justify-content: Flexbox layout controls
  - flex-direction: column: Stacks title elements vertically
{% endcomment %}
{% style %}
  {% if section.settings.title_alignment == 'center' %}
    .section-id-{{ section.id }}h2 {
      text-align: center;
      width: 100%;
      padding: 0;
    }
    .section-id-{{ section.id }}.section-heading {
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      flex-direction: column;
    }
  {% endif %}
{% endstyle %}

{% comment %}
  =============================================================================
  DYNAMIC BACKGROUND COLOR CSS
  =============================================================================
  Generates CSS for custom background color when specified
  - section.settings.color_bg: Background color from theme editor
  - unless blank: Only applies when color is specified
  - section-id-{{ section.id }}: Section-specific CSS targeting
  - background-color: Sets custom background color
{% endcomment %}
{% style %}
  {% unless section.settings.color_bg == blank %}
    .section-id-{{ section.id }}{
      background-color: {{ section.settings.color_bg }}
      ;
    }
  {% endunless %}
{% endstyle %}

{% comment %}
  =============================================================================
  WAVE DIVIDER INTEGRATION
  =============================================================================
  Renders wave divider with customizable positioning and colors
  - section.settings.wave: Wave position setting from theme editor
  - "none": No wave divider displayed
  - render 'wave-styles': External snippet for wave styling
  - wave_position: Passes wave position to snippet
  - section_id: Passes section ID for CSS targeting
  - fill_color: Passes background color for wave styling
{% endcomment %}
{%- if section.settings.wave != "none" -%}
  {%- render 'wave-styles' 
    , wave_position: section.settings.wave,
    section_id: section.id,
    fill_color: section.settings.color_bg -%}
{%- endif -%}

{% comment %}
  =============================================================================
  ROWS LAYOUT GRID CLASS ASSIGNMENT
  =============================================================================
  Determines CSS grid classes based on grid setting for rows layout
  - section.settings.layout == 'rows': Only applies to rows layout
  - section.settings.grid: Grid columns setting (2, 3, or 4)
  - column half: 2-column grid (50% width each)
  - column third: 3-column grid (33.33% width each)
  - column quarter: 4-column grid (25% width each)
  - product_class: CSS class for responsive grid columns
{% endcomment %}
{%- if section.settings.layout == 'rows' -%}
  {%- if section.settings.grid == 2 -%}
    {%- assign product_class = 'column half' -%}
  {%- elsif section.settings.grid == 3 -%}
    {%- assign product_class = 'column third' -%}
  {%- else -%}
    {%- assign product_class = 'column quarter' -%}
  {%- endif -%}
{%- endif -%}

{% comment %}
  =============================================================================
  MAXIMUM PRODUCT COUNT CALCULATION
  =============================================================================
  Calculates maximum number of products to display
  - section.settings.grid: Number of columns
  - section.settings.rows: Number of rows
  - times: Multiplies grid by rows for total capacity
  - section.settings.max_products: Custom limit from theme editor
  - at_most: Applies custom limit if specified
  - max_products: Final product count for display
{% endcomment %}
{%- assign max_products = section.settings.grid | times: section.settings.rows -%}
{%- if section.settings.max_products > 0 -%}
  {%- assign max_products = max_products | at_most: section.settings.max_products -%}
{%- endif -%}

{% comment %}
  =============================================================================
  ANIMATION TYPE SELECTION
  =============================================================================
  Selects animation type based on layout setting
  - animation_type: CSS animation class for entrance effects
  - cc-fade-in-up: Default animation for rows layout
  - cc-fade-in: Animation for columns layout
  - section.settings.layout: Layout type from theme editor
  - Controls how products animate into view
{% endcomment %}
{% assign animation_type = "cc-fade-in-up" %}
{%- if section.settings.layout == "columns" -%}
  {% assign animation_type = "cc-fade-in" %}
{%- endif -%}

{% comment %}
  =============================================================================
  RELATED PRODUCTS METAFIELD INTEGRATION
  =============================================================================
  Checks for related products metafield integration
  - use_related_products_metafield: Boolean flag for metafield usage
  - section.settings.related_products_metafield: Setting from theme editor
  - product != blank: Ensures product context exists
  - product.metafields.custom.related_products.value: Metafield value
  - split: ',': Splits comma-separated product handles
  - related_products_list: Array of related product handles
{% endcomment %}
{%- assign use_related_products_metafield = false -%}
{%- if section.settings.related_products_metafield and product != blank and product.metafields.custom.related_products.value -%}
  {%- assign related_products_list = product.metafields.custom.related_products | split: ',' -%}
  {%- if related_products_list.size > 0 -%}
    {%- assign use_related_products_metafield = true -%}
  {%- endif -%}
{%- endif -%}

{% comment %}
  =============================================================================
  CAROUSEL LAYOUT CONTAINER
  =============================================================================
  Opens carousel container when carousel layout is selected
  - section.settings.layout == 'carousel': Carousel layout check
  - product-slider: CSS class for carousel container
  - Only rendered when carousel layout is active
{% endcomment %}
{% if section.settings.layout == 'carousel' %}
  <div class="product-slider">
  {% endif %}

  {% comment %}
    =============================================================================
    MAIN SECTION CONTAINER
    =============================================================================
    Primary container for featured collection section
    - wide-container half-gutter: Full-width container with reduced spacing
    - section-id-{{ section.id }}: Section-specific CSS targeting
    - use-alt-bg: Alternative background color class when enabled
    - data-section-type: JavaScript hook for section functionality
    - data-components: Component initialization data
    - data-cc-animate: Animation trigger for section entrance
  {% endcomment %}
  <div
    class="wide-container half-gutter section-id-{{ section.id }} {% if section.settings.alternate_bg_color %}use-alt-bg {% endif %}"
    data-section-type="dtc-featured-collection"
    data-components="product-block"
    data-cc-animate>

    {% comment %}
      =============================================================================
      SECTION HEADING CONTAINER
      =============================================================================
      Container for section title, body text, and view all link
      - section-heading: Heading wrapper styling class
      - data-cc-animate: Animation trigger for heading entrance
      - Conditional display based on title or view all setting
    {% endcomment %}
    {% if section.settings.title != blank or section.settings.show_view_all %}
      <div class="section-heading" data-cc-animate>
        {% comment %}
          =============================================================================
          SECTION TITLE
          =============================================================================
          Main heading for featured collection section
          - section.settings.title: Title text from theme editor
          - h2 class: Consistent heading styling
          - data-cc-animate-click: Animation trigger for title interaction
          - collections[section.settings.collection].url: Collection page link
          - escape: Escapes HTML in title for security
        {% endcomment %}
        {% if section.settings.title != blank %}
          <h2 class="h2">
            <a data-cc-animate-click href="{{ collections[section.settings.collection].url }}">
              {{ section.settings.title | escape }}
            </a>
          </h2>
        {% else %}
          <div></div>
        {% endif %}

        {% comment %}
          =============================================================================
          SECTION BODY TEXT
          =============================================================================
          Descriptive text below section title
          - section.settings.body_text: Body text from theme editor
          - Supports HTML content for rich formatting
          - Optional content for additional context
        {% endcomment %}
        {% if section.settings.body_text != blank %}
          {{ section.settings.body_text }}
        {% endif %}

        {% comment %}
          =============================================================================
          VIEW ALL LINK
          =============================================================================
          Link to view all products in collection
          - section.settings.show_view_all: Boolean setting for link visibility
          - data-cc-animate-click: Animation trigger for link interaction
          - view-all-link: CSS class for link styling
          - collections.general.view_all: Localized "View All" text
          - collections[section.settings.collection].url: Collection page destination
        {% endcomment %}
        {% if section.settings.show_view_all %}
          <a
            data-cc-animate-click
            class="view-all-link"
            href="{{ collections[section.settings.collection].url }}">
            {{ 'collections.general.view_all' | t }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% comment %}
      =============================================================================
      CAROUSEL CONTAINER
      =============================================================================
      Swiper.js carousel container for carousel layout
      - section.settings.layout == 'carousel': Carousel layout check
      - swiper-container: Required class for Swiper.js functionality
      - product-list: Product list styling class
      - product-list--{{ section.settings.layout }}: Layout-specific styling
      - data-products-in-view: Number of products visible in carousel
      - section.settings.grid: Grid setting determines visible products
    {% endcomment %}
    {% if section.settings.layout == 'carousel' %}
      <div class="swiper-container product-list product-list--{{ section.settings.layout }}"data-products-in-view="{{ section.settings.grid }}">

        <div
          class="swiper-wrapper"
          data-normheights=".image"
          data-normheights-inner="img">
          {%- if use_related_products_metafield -%}
            {%- for related_product in product.metafields.custom.related_products.value -%}
              <div class="swiper-slide">
                {%- assign animate_delay = forloop.index | times: 0.4 -%}
                {% render 'product-block', product: related_product, product_class: product_class, i: forloop.index, animate: animate_delay, show_vendor: section.settings.show_vendor, hide_swatches: section.settings.hide_swatches %}
              </div>
            {%- endfor -%}
          {% elsif section.settings.collection != blank %}
            {% assign collection = collections[section.settings.collection] %}
            {% if section.settings.product_type_collection %}
              {% assign product_type = product.type | handleize %}
              {% assign collection = collections[product_type] %}
            {% endif %}
            {% for product in collection.products limit: 12 %}
              <div class="swiper-slide">
                {% assign animate_delay = forloop.index | times: 0.4 %}
                {% render 'product-block', product: product, product_class: product_class, i: forloop.index, animate: animate_delay, show_vendor: section.settings.show_vendor, hide_swatches: section.settings.hide_swatches %}
              </div>
            {% endfor %}
          {% else %}
            {% for i in (1..max_products) %}
              <div class="swiper-slide">
                {% assign animate_delay = forloop.index | times: 0.4 %}
                {% render 'onboarding-product-block', i: forloop.index, product_class: product_class, animate: animate_delay %}
              </div>
            {% endfor %}
          {% endif %}
        </div>

        <div class="swiper-scrollbar"></div>
        <a
          href="#"
          class="swiper-button-prev"
          aria-label="{{ 'general.accessibility_labels.previous' | t | escape }}">{% render 'svg-chevron-left' %}</a>
        <a
          href="#"
          class="swiper-button-next"
          aria-label="{{ 'general.accessibility_labels.next' | t | escape }}">{% render 'svg-chevron-right' %}</a>
      </div>
    {% else %}
      <div class="product-list
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            product-list--{{ section.settings.layout }}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {% if section.settings.grid_mobile == '2' %}mob-two-col{% endif %}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            mob-show-{{ section.settings.rows | times: section.settings.grid_mobile }}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            {% if section.settings.layout == 'columns' %}jiggly-split dynamic-col-{{ section.settings.grid }}{% else %}grid--uniform{% endif %}">
        {%- if use_related_products_metafield -%}
          <div class="dtc-product-wrapper">
            {% for related_product in product.metafields.custom.related_products.value limit: 1 %}
              {% render 'dtc-block' with related_product: related_product %}
            {% endfor %}
          </div>
        {% elsif section.settings.collection != blank %}
          {% assign collection = collections[section.settings.collection] %}
          {% if section.settings.product_type_collection %}
            {% assign product_type = product.type | handleize %}
            {% if product.type == 'House Hoodie' %}
              {% assign product_type = 'House Hoodies' | handleize %}
            {% endif %}
            {% if product.type == 'JamTee' %}
              {% assign product_type = 'JamTees' | handleize %}
            {% endif %}
            
            {% if product.type == 'Double Cozy Cloak' or product.type == 'Cozy Cloak' %}
              
            {% endif %}
            {% assign collection = collections[product_type] %}
          {% endif %}
          {% for product in collection.products limit: max_products %}
            {% render 'product-block', product: product, product_class: product_class, animation_type: animation_type, i: forloop.index, show_vendor: section.settings.show_vendor, animate: forloop.index, hide_swatches: section.settings.hide_swatches %}
          {% endfor %}
        {% else %}
          {% for i in (1..max_products) %}
            {% assign animate_delay = forloop.index | times: 0.4 %}
            {% render 'onboarding-product-block', i: forloop.index, product_class: product_class, animate: animate_delay, animation_type: animation_type %}
          {% endfor %}
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% comment %}
    =============================================================================
    CAROUSEL LAYOUT CLOSING TAG
    =============================================================================
    Closes carousel container when carousel layout is selected
    - section.settings.layout == 'carousel': Carousel layout check
    - product-slider: CSS class for carousel container
    - Only rendered when carousel layout is active
  {% endcomment %}
  {% if section.settings.layout == 'carousel' %}
  </div>
{% endif %}
{% schema %}
{
  "name": "DTC Featured collection",
  "class": "section-featured-collection dtc-single-upsell",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "right"
        }
      ],
      "default": "left"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "product_type_collection",
      "label": "Use product type as collection",
      "info": "Only works on the product template",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "related_products_metafield",
      "label": "Use related products metafield",
      "info": "Only works on the product template",
      "default": false
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "columns",
          "label": "Collage"
        },
        {
          "value": "rows",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "rows",
      "info": "Collage will only work when the 'Image shape' is set to Natural - in Products / Image shape"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    },
    {
      "type": "range",
      "id": "grid",
      "label": "Desktop products per row",
      "min": 2,
      "max": 4,
      "default": 3
    },
    {
      "type": "range",
      "id": "rows",
      "label": "Rows",
      "min": 1,
      "max": 4,
      "default": 2,
      "info": "Does not apply to carousel layout"
    },
    {
      "type": "select",
      "id": "grid_mobile",
      "label": "Mobile products per row",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "number",
      "id": "max_products",
      "label": "Maximum product count"
    },
    {
      "type": "checkbox",
      "id": "hide_swatches",
      "label": "Hide color swatches",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "alternate_bg_color",
      "label": "Use alternate section color",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "select",
      "id": "wave",
      "label": "Wave",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "both",
          "label": "Both"
        }
      ],
      "default": "none"
    },
    {
      "id": "color_bg",
      "type": "color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "DTC Featured collection",
      "settings": {
      }
    }
  ],
  "templates": [
    "article",
    "index",
    "page",
    "product",
    "collection",
    "blog",
    "list-collections",
    "search",
    "404",
    "cart"
  ]
}
{% endschema %}