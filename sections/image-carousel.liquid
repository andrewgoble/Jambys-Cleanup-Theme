{% comment %}
  =============================================================================
  IMAGE CAROUSEL SECTION - INFINITE SCROLLING IMAGE DISPLAY
  =============================================================================
  Continuous scrolling image carousel with infinite loop animation
  - CSS-based animation for smooth, performant scrolling
  - Automatic loop calculation based on image count and target width
  - Responsive image sizing with lazy loading
  - Configurable background color and animation speed
  - Seamless infinite scrolling effect
{% endcomment %}

{% comment %}
  =============================================================================
  CAROUSEL LOOP CALCULATION
  =============================================================================
  Calculates the number of loops needed for seamless infinite scrolling
  - target_width: 2600px - Base width for loop calculations
  - block_width: Total width of all images (200px per image)
  - loop_count: Number of complete loops needed to fill target width
  - frame_width: Total width of the scrolling frame
  - Ensures smooth, continuous scrolling without visible gaps
{% endcomment %}
{% if section.blocks.size > 0 %}
  
  {% assign target_width = 2600 %}
  {% assign block_width = section.blocks.size | times: 200 %}
  {% assign loop_count = target_width | divided_by: block_width %}
  {% assign loop_width = loop_count | times: block_width %}
  {% if loop_width < target_width %}
    {% assign loop_count = loop_count | plus: 1 %}
  {% endif %}
  {% assign frame_width = loop_count | times: section.blocks.size | times: 200 %}
  {% assign loop_count = loop_count | times: 2 %}

  {% comment %}
    =============================================================================
    CSS ANIMATION STYLES
    =============================================================================
    Dynamic CSS for carousel animation and layout
    - moveSlideshow: Keyframe animation for horizontal scrolling
    - carousel-wrapper: Container with background color and padding
    - carousel: Main carousel container with overflow handling
    - slides-wrapper: Animation container with calculated width
    - slides: Flexbox container for image layout
    - slide: Individual slide with centered image
  {% endcomment %}
    <style>
      {% comment %}
        =============================================================================
        KEYFRAME ANIMATION DEFINITION
        =============================================================================
        Defines the horizontal scrolling animation
        - 0%: Starting position (translateX(0))
        - 100%: End position (translateX(-100%))
        - Creates seamless infinite scrolling effect
      {% endcomment %}
      @keyframes moveSlideshow {
          0% { transform: translateX(0); }
          100% {transform: translateX(-100%)}
      } 

      {% comment %}
        =============================================================================
        CAROUSEL WRAPPER STYLING
        =============================================================================
        Outer container with background color and padding
        - width: 100% for full container width
        - padding: 10px vertical spacing
        - background-color: Dynamic color from section settings
      {% endcomment %}
      #carousel-wrapper-{{ section.id }} {
        width : 100%;
        padding:10px 0;
        background-color: {{ section.settings.background_color }}
      }
      
      {% comment %}
        =============================================================================
        MAIN CAROUSEL CONTAINER
        =============================================================================
        Primary carousel element with overflow handling
        - width: 100% for full width
        - position: relative for absolute positioning context
        - overflow: hidden to clip scrolling content
        - border-radius: 15px for rounded corners
      {% endcomment %}
      #carousel-{{ section.id }} {
        width : 100%;
        position : relative;
        overflow-x : hidden;
        overflow-y : hidden;
        border-radius : 15px;
      }
      
      {% comment %}
        =============================================================================
        SLIDES WRAPPER ANIMATION
        =============================================================================
        Container that handles the scrolling animation
        - width: Calculated frame width for proper scrolling
        - animation-duration: Speed from section settings
        - animation-timing-function: linear for smooth scrolling
        - animation-iteration-count: infinite for continuous loop
        - animation-name: moveSlideshow keyframe reference
      {% endcomment %}
      #carousel-{{ section.id }} .slides-wrapper {
        width : {{ frame_width }}px;
        animation-duration : {{ section.settings.carousel_speed }}s;
        animation-timing-function : linear;
        animation-delay : 0s;
        animation-iteration-count : infinite;
        animation-direction : normal;
        animation-fill-mode : none;
        animation-play-state : running;
        animation-name : moveSlideshow;
      }
      
      {% comment %}
        =============================================================================
        SLIDES CONTAINER LAYOUT
        =============================================================================
        Flexbox container for horizontal image layout
        - display: flex for horizontal image arrangement
        - width: max-content to accommodate all images
        - Enables smooth horizontal scrolling
      {% endcomment %}
      #carousel-{{ section.id }} .slides {
        display : flex;
        width : max-content;
      }
      
      {% comment %}
        =============================================================================
        INDIVIDUAL SLIDE STYLING
        =============================================================================
        Single slide container with centered content
        - display: flex for vertical content alignment
        - flex-direction: column for stacked layout
        - align-items: center for horizontal centering
      {% endcomment %}
      #carousel-{{ section.id }} .slides .slide {
        display : flex;
        flex-direction : column;
        align-items : center;
      }
      
      {% comment %}
        =============================================================================
        SLIDE IMAGE CONTAINER
        =============================================================================
        Image wrapper with fixed dimensions and styling
        - width/height: 192px for consistent image sizing
        - position: relative for absolute image positioning
        - border-radius: 15px for rounded corners
        - overflow: hidden to clip image content
        - margin: 4px spacing between slides
      {% endcomment %}
      #carousel-{{ section.id }} .slides .slide .image {
        width : 192px;
        height : 192px;
        position : relative;
        border-radius : 15px;
        overflow-x : hidden;
        overflow-y : hidden;
        margin : 0px 4px;
      }
      
      {% comment %}
        =============================================================================
        SLIDE IMAGE STYLING
        =============================================================================
        Individual image element with responsive sizing
        - position: absolute for precise positioning
        - width/height: 100% to fill container
        - object-fit: cover for proper image scaling
        - Maintains aspect ratio while filling container
      {% endcomment %}
      #carousel-{{ section.id }} .slides .slide .image img {
        position : absolute;
        width : 100%;
        height : 100%;
        object-fit : cover;
      }
    </style>

    {% comment %}
      =============================================================================
      CAROUSEL HTML STRUCTURE
      =============================================================================
      Main carousel markup with calculated loop structure
      - carousel-wrapper: Outer container with background
      - carousel: Main scrolling container
      - slides-wrapper: Animation wrapper
      - slides: Image container with loop-generated content
    {% endcomment %}
    <div id="carousel-wrapper-{{ section.id }}">
      <div id="carousel-{{ section.id }}" class="carousel">
          <div class="slides-wrapper">
              <div id="carousel-{{ section.id }}" class="slides">
                {% comment %}
                  =============================================================================
                  LOOP GENERATION FOR SEAMLESS SCROLLING
                  =============================================================================
                  Generates multiple copies of images for infinite scrolling
                  - Outer loop: Creates multiple complete sets of images
                  - Inner loop: Iterates through section blocks (images)
                  - loop_count: Calculated number of loops for seamless effect
                  - Each iteration creates a complete slide with image
                {% endcomment %}
                {% for i in (1..loop_count) %}
                  {% for block in section.blocks %}
                    <div class="slide">
                        <div class="image"><img src="{{ block.settings.image | image_url: width: 300, height: 300, crop: 'center' }}" loading="lazy"></div>
                    </div>
                  {% endfor %}
                {% endfor %}
              </div>
          </div>
      </div>
    </div>
{% endif %}

{% comment %}
  =============================================================================
  IMAGE CAROUSEL SECTION SCHEMA - CONFIGURATION & CUSTOMIZATION
  =============================================================================
  Theme editor configuration for image carousel section
  - name: Section name displayed in theme editor
  - background_color: Customizable background color
  - carousel_speed: Animation duration in seconds (10+ seconds)
  - blocks: Image blocks for carousel content
{% endcomment %}
{% schema %}
{
  "name": "Image Carousel",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "range",
      "id": "carousel_speed",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "s",
      "label": "Carousel Speed",
      "default": 30,
      "info": "scrolling speed will vary slightly depending on how many items exist"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Select an image for the carousel"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Carousel",
      "settings": {
      }
    }
  ]
}
{% endschema %}