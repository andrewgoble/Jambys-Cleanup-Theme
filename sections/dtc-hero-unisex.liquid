{% comment %}
  =============================================================================
  DTC HERO UNISEX SECTION - ADVANCED HERO SLIDER WITH DUAL BUTTONS
  =============================================================================
  Advanced hero slider section with Swiper.js integration and dual button system
  - Inline CSS for responsive button layout and styling
  - Swiper.js carousel with conditional navigation controls
  - Slide counting logic for navigation button visibility
  - Dual button system with extensive color customization
  - Video support with image fallback
  - Responsive design with mobile optimization
  - Used for unisex product category hero sections
{% endcomment %}

{% comment %}
  =============================================================================
  INLINE CSS STYLING
  =============================================================================
  Section-specific CSS for button layout and responsive design
  - hero-slider-content__buttons: Button container styling
  - Responsive gap adjustments for mobile devices
  - Mobile-specific button width and layout modifications
  - Ensures consistent button spacing across devices
{% endcomment %}
<style>
  /* #unisex-slider{
    opacity:0; visibility:hidden; height:0;
  } */
  .hero-slider-content__buttons{
    display:flex;
    gap:20px;
  }
  
  @media (max-width: 480px) { 
    .hero-slider-content__buttons{
    gap:5px;
    width:100%;
    justify-content: space-around;
    flex-wrap: wrap;
  }
  .hero-slider-content__buttons a{
    width:50%;
  }
  }
</style>

{% comment %}
  =============================================================================
  HERO SLIDER CONTAINER
  =============================================================================
  Main container for unisex hero slider with Swiper.js integration
  - dtc-hero-slider: Primary wrapper for hero slider
  - id="unisex-slider": Unique identifier for JavaScript targeting
  - Contains all slider functionality and content
{% endcomment %}
<div class="dtc-hero-slider" id= "unisex-slider">

  {% comment %}
    =============================================================================
    SWIPER.JS CAROUSEL WRAPPER
    =============================================================================
    Swiper.js carousel container for slide management
    - swiper-wrapper: Required class for Swiper.js functionality
    - Contains all individual slide elements
    - Swiper.js automatically handles slide transitions and positioning
  {% endcomment %}
  <div class="swiper-wrapper">
    {% comment %}
      =============================================================================
      SLIDE COUNTING LOGIC
      =============================================================================
      Tracks total number of slides for navigation control
      - total_slides: Counter variable for slide count
      - plus: 1: Increments counter for each slide block
      - Used to determine navigation button visibility
    {% endcomment %}
    {% assign total_slides = 0 %}

    {% comment %}
      =============================================================================
      HERO SLIDE BLOCKS ITERATION
      =============================================================================
      Loops through all configured hero slide blocks
      - section.blocks: Array of slide blocks from theme editor
      - block: Individual slide block with settings
      - Each block represents one hero slide
    {% endcomment %}
    {%- for block in section.blocks -%}
      {% comment %}
        =============================================================================
        SLIDE COUNT INCREMENT
        =============================================================================
        Increments slide counter for each block
        - total_slides: Running total of configured slides
        - plus: 1: Adds one to counter for each iteration
        - Used for conditional navigation display
      {% endcomment %}
      {% assign total_slides = total_slides | plus: 1 %}

      {% comment %}
        =============================================================================
        INDIVIDUAL HERO SLIDE
        =============================================================================
        Single hero slide with Swiper.js integration
        - swiper-slide: Required class for Swiper.js slide functionality
        - slide-content: Wrapper for slide content layout
        - Contains slide information and media content
      {% endcomment %}
      <div class="swiper-slide">
        <div class="slide-content">
          {% comment %}
            =============================================================================
            SLIDE TYPE CASE STATEMENT
            =============================================================================
            Determines slide content based on block type
            - block.type: Block type identifier from theme editor
            - when 'slide': Standard slide block type
            - render 'dtc-hero-slide': Uses external snippet for slide content
            - block: block: Passes block settings to snippet
          {% endcomment %}
          {%- case block.type -%}
            {%- when 'slide' -%}
              {% render 'dtc-hero-slide', block: block %}
          {%- endcase -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {% comment %}
    =============================================================================
    SWIPER.JS PAGINATION DOTS
    =============================================================================
    Navigation dots for slide position indication
    - swiper-pagination: Required class for Swiper.js pagination
    - Automatically generated by Swiper.js
    - Shows current slide position and total slides
    - Clickable for direct slide navigation
  {% endcomment %}
  <div class="swiper-pagination"></div>

  {% comment %}
    =============================================================================
    CONDITIONAL NAVIGATION ARROWS
    =============================================================================
    Navigation arrows displayed only when multiple slides exist
    - total_slides != 1: Only shows navigation when more than one slide
    - swiper-button-prev: Previous slide button
    - swiper-button-next: Next slide button
    - Prevents unnecessary navigation for single-slide sliders
  {% endcomment %}
  {% if total_slides != 1 %}
  <!-- If we need navigation buttons -->
  <div class="swiper-button-prev"></div>
  <div class="swiper-button-next"></div>
  {% endif %}
</div>

{% comment %}
  =============================================================================
  DTC HERO UNISEX SECTION SCHEMA - CONFIGURATION & CUSTOMIZATION
  =============================================================================
  Theme editor configuration for unisex hero slider
  - name: Section name displayed in theme editor
  - class: CSS class for section styling
  - tag: HTML tag for section wrapper
  - settings: Configurable slider and background options
  - blocks: Slide block configuration with dual button system
  - presets: Default section configuration
{% endcomment %}
{% schema %}
{
  {% comment %}
    =============================================================================
    SCHEMA BASIC CONFIGURATION
    =============================================================================
    Core section configuration for theme editor
    - name: Display name in theme editor sidebar
    - class: CSS class for section styling and functionality
    - tag: HTML tag for section wrapper
  {% endcomment %}
  "name": "dtc hero unisex slider",
  "class": "dtc-hero-slider-unisex",
  "tag": "section",

  {% comment %}
    =============================================================================
    SECTION SETTINGS - SLIDER & BACKGROUND CONFIGURATION
    =============================================================================
    Configurable options for slider behavior and appearance
    - loop_slider: Controls continuous loop behavior
    - background_color: Custom background color selection
  {% endcomment %}
  "settings": [
    {% comment %}
      =============================================================================
      LOOP SLIDER SETTING
      =============================================================================
      Controls continuous loop behavior of slider
      - type: "checkbox": Boolean toggle in theme editor
      - id: "loop_slider": Internal identifier for Liquid access
      - label: "Loop slider": User-friendly label in theme editor
      - default: true: Default enabled state for smooth experience
    {% endcomment %}
    {
      "type": "checkbox",
      "id": "loop_slider",
      "label": "Loop slider",
      "default": true
    },

    {% comment %}
      =============================================================================
      BACKGROUND COLOR SETTING
      =============================================================================
      Custom background color for slider section
      - type: "color": Color picker in theme editor
      - label: "Background color": User-friendly label
      - id: "background_color": Internal identifier for Liquid access
      - Overrides default theme background colors
    {% endcomment %}
    {
      "type": "color",
      "label": "Background color",
      "id": "background_color"
    }
  ],

  {% comment %}
    =============================================================================
    SECTION BLOCKS - ADVANCED HERO SLIDE MANAGEMENT
    =============================================================================
    Slide block configuration with dual button system and extensive customization
    - Merchants can add multiple slide blocks
    - Each block supports dual buttons with individual color schemes
    - Video support with image fallback
    - Comprehensive color customization for all button states
  {% endcomment %}
  "blocks": [
    {% comment %}
      =============================================================================
      SLIDE BLOCK TYPE
      =============================================================================
      Advanced hero slide block with dual button system
      - name: "Slide": Display name in theme editor
      - type: "slide": Internal identifier for block type
      - settings: Extensive configurable options for slide content
    {% endcomment %}
    {
      "name": "Slide",
      "type": "slide",
      "settings": [
        {% comment %}
          =============================================================================
          SLIDE IMAGE SETTING
          =============================================================================
          Hero slide background image selection
          - type: "image_picker": Image selector in theme editor
          - id: "image": Internal identifier for Liquid access
          - label: "Image": User-friendly label in theme editor
          - Visual background for hero slide
        {% endcomment %}
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },

        {% comment %}
          =============================================================================
          SLIDE VIDEO SETTING
          =============================================================================
          Hero slide video file with image fallback
          - id: "video_file": Internal identifier for Liquid access
          - type: "video": Video file selector in theme editor
          - label: "Video": User-friendly label in theme editor
          - info: Explains video priority over image
          - Video displays instead of image when provided
        {% endcomment %}
        {
          "id": "video_file",
          "type": "video",
          "label": "Video",
          "info": "if there is a video, it will be displayed instead of the image"
        },

        {% comment %}
          =============================================================================
          SLIDE TITLE SETTING
          =============================================================================
          Main heading for hero slide
          - type: "text": Simple text input field
          - id: "title": Internal identifier for Liquid access
          - label: "Title": User-friendly label in theme editor
          - Displayed prominently on slide
        {% endcomment %}
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },

        {% comment %}
          =============================================================================
          SLIDE DESCRIPTION SETTING
          =============================================================================
          Descriptive text below slide title
          - type: "textarea": Multi-line text input field
          - id: "description": Internal identifier for Liquid access
          - label: "Description": User-friendly label in theme editor
          - Supports longer descriptive content
        {% endcomment %}
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },

        {% comment %}
          =============================================================================
          PRIMARY BUTTON LABEL SETTING
          =============================================================================
          Text displayed on primary call-to-action button
          - type: "text": Simple text input field
          - id: "button_label": Internal identifier for Liquid access
          - label: "Button Label": User-friendly label in theme editor
          - Displayed on primary CTA button
        {% endcomment %}
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label"
        },

        {% comment %}
          =============================================================================
          PRIMARY BUTTON LINK SETTING
          =============================================================================
          Destination URL for primary call-to-action button
          - type: "url": URL input field with validation
          - id: "button_link": Internal identifier for Liquid access
          - label: "Button link": User-friendly label in theme editor
          - Links to collection, product, or external page
        {% endcomment %}
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },

        {% comment %}
          =============================================================================
          PRIMARY BUTTON BACKGROUND COLOR
          =============================================================================
          Background color for primary button
          - type: "color": Color picker in theme editor
          - id: "btn_bg_color": Internal identifier for Liquid access
          - label: "Button Background": User-friendly label
          - Customizes primary button appearance
        {% endcomment %}
        {
          "type": "color",
          "id": "btn_bg_color",
          "label": "Button Background"
        },

        {% comment %}
          =============================================================================
          PRIMARY BUTTON BORDER COLOR
          =============================================================================
          Border color for primary button
          - type: "color": Color picker in theme editor
          - id: "btn_border_color": Internal identifier for Liquid access
          - label: "Button Border": User-friendly label
          - Customizes primary button border appearance
        {% endcomment %}
        {
          "type": "color",
          "id": "btn_border_color",
          "label": "Button Border"
        },

        {% comment %}
          =============================================================================
          PRIMARY BUTTON TEXT COLOR
          =============================================================================
          Text color for primary button
          - type: "color": Color picker in theme editor
          - id: "btn_text_color": Internal identifier for Liquid access
          - label: "Button Text": User-friendly label
          - Customizes primary button text appearance
        {% endcomment %}
        {
          "type": "color",
