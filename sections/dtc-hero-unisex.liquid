          - id: "btn2_border_color": Internal identifier for Liquid access
          - label: "Second Button Border": User-friendly label
          - Customizes secondary button border appearance
        {% endcomment %}
        {
          "type": "color",
          "id": "btn2_border_color",
          "label": "Second Button Border"
        },

        {% comment %}
          =============================================================================
          SECONDARY BUTTON TEXT COLOR
          =============================================================================
          Text color for secondary button
          - type: "color": Color picker in theme editor
          - id: "btn2_text_color": Internal identifier for Liquid access
          - label: "Second Button Text": User-friendly label
          - Customizes secondary button text appearance
        {% endcomment %}
        {
          "type": "color",
          "id": "btn2_text_color",
          "label": "Second Button Text"
        },

        {% comment %}
          =============================================================================
          SECONDARY BUTTON HOVER BACKGROUND COLOR
          =============================================================================
          Background color for secondary button hover state
          - type: "color": Color picker in theme editor
          - id: "btn2_hover_color": Internal identifier for Liquid access
          - label: "Second Hover Color": User-friendly label
          - Customizes secondary button hover appearance
        {% endcomment %}
        {
          "type": "color",
          "id": "btn2_hover_color",
          "label": "Second Hover Color"
        },

        {% comment %}
          =============================================================================
          SECONDARY BUTTON HOVER TEXT COLOR
          =============================================================================
          Text color for secondary button hover state
          - type: "color": Color picker in theme editor
          - id: "btn2_hover_text_color": Internal identifier for Liquid access
          - label: "Second Hover Text Color": User-friendly label
