          =============================================================================
          Background color for primary button hover state
          - type: "color": Color picker in theme editor
          - id: "btn_hover_color": Internal identifier for Liquid access
          - label: "Hover Color": User-friendly label
          - Customizes primary button hover appearance
        {% endcomment %}
        {
          "type": "color",
          "id": "btn_hover_color",
          "label": "Hover Color"
        },

        {% comment %}
          =============================================================================
          PRIMARY BUTTON HOVER TEXT COLOR
          =============================================================================
          Text color for primary button hover state
          - type: "color": Color picker in theme editor
          - id: "btn_hover_text_color": Internal identifier for Liquid access
          - label: "Hover Text Color": User-friendly label
          - Customizes primary button hover text appearance
        {% endcomment %}
        {
          "type": "color",
          "id": "btn_hover_text_color",
          "label": "Hover Text Color"
        },

        {% comment %}
          =============================================================================
          SECONDARY BUTTON LABEL SETTING
          =============================================================================
          Text displayed on secondary call-to-action button
          - type: "text": Simple text input field
          - id: "second_button_label": Internal identifier for Liquid access
          - label: "Second Button Label": User-friendly label in theme editor
          - Displayed on secondary CTA button
        {% endcomment %}
        {
          "type": "text",
          "id": "second_button_label",
          "label": "Second Button Label"
        },

        {% comment %}
          =============================================================================
          SECONDARY BUTTON LINK SETTING
          =============================================================================
