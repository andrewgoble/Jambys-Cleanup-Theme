{% comment %}
  =============================================================================
  ACCORDIONS SECTION
  =============================================================================
  Collapsible content section with expandable/collapsible items
  - Supports both FAQ-style content and product-specific accordions
  - Dynamic styling with customizable background colors and wave effects
  - Responsive layout with reading-width container for optimal readability
  - JavaScript-powered accordion functionality with smooth animations
  - Integrates with product pages for product-specific FAQ content
{% endcomment %}

{% comment %}
  =============================================================================
  TITLE ALIGNMENT STYLING
  =============================================================================
  Dynamic CSS for section title alignment
  - title_alignment: Controls heading text alignment (left/center/right)
  - section-heading: Container for title and view all link
  - flex-wrap: wrap for responsive text wrapping
  - align-items: center for vertical centering
  - justify-content: center for horizontal centering
  - flex-direction: column for stacked layout
{% endcomment %}
{% style %}
  {% if section.settings.title_alignment == 'center' %}
  .section-id-{{ section.id }} h2 {
    text-align: center;
    width: 100%;
    padding: 0;
  }
  .section-id-{{ section.id }} .section-heading {
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }
  {% endif %}
{% endstyle %}

{% comment %}
  =============================================================================
  BACKGROUND COLOR STYLING
  =============================================================================
  Dynamic background color from section settings
  - color_bg: Custom background color from theme editor
  - section-id-{{ section.id }}: Unique identifier for section-specific styling
  - Only applies background color if setting is not blank
  - Allows merchants to customize section appearance
{% endcomment %}
{% style %}
  {% unless section.settings.color_bg == blank %}
     .section-id-{{ section.id }} {
        background-color: {{ section.settings.color_bg }};
     }
  {% endunless %}
{% endstyle %}

{% comment %}
  =============================================================================
  WAVE STYLING INTEGRATION
  =============================================================================
  Optional decorative wave borders for visual interest
  - wave: Wave position setting (none/top/bottom/both)
  - wave-styles: Snippet for rendering wave SVG elements
  - wave_position: Passes wave position to wave-styles snippet
  - section_id: Unique section identifier for styling
  - fill_color: Wave color matches section background color
  - Creates seamless integration between waves and background
{% endcomment %}
{%- if section.settings.wave != "none" -%}
  {%- render 'wave-styles', 
    wave_position: section.settings.wave, 
    section_id: section.id,
    fill_color: section.settings.color_bg -%}
{%- endif -%}

{% comment %}
  =============================================================================
  MAIN ACCORDION CONTAINER
  =============================================================================
  Primary container with section identification and component setup
  - id="section-id-{{ section.id }}": Unique section identifier
  - data-section-type="accordion": Identifies section type for JavaScript
  - half-gutter: Reduced spacing for tighter layout
  - section-spacing: Consistent vertical spacing between sections
  - section-id-{{ section.id }}: CSS class for section-specific styling
  - use-alt-bg: Optional alternate background color class
  - data-components="accordion": Required JavaScript component
{% endcomment %}
<div id="section-id-{{ section.id }}" data-section-type="accordion" class="half-gutter section-spacing section-id-{{ section.id }} {% if section.settings.alternate_bg_color %}use-alt-bg{% endif %}" data-components="accordion">

  {% comment %}
    =============================================================================
    ACCORDION CONTENT CONTAINER
    =============================================================================
    Content wrapper with responsive width and title handling
    - accordion-container: Main content wrapper
    - reading-width: Optimal width for readable content
    - no-title: CSS class when no title is provided
    - section.settings.title: Section title from theme editor
  {% endcomment %}
  <div class="accordion-container reading-width {% if section.settings.title == blank %}no-title{% endif %}">

    {% comment %}
      =============================================================================
      SECTION HEADING & TITLE
      =============================================================================
      Section title with optional view all link
      - section-heading: Container for title and navigation
      - section-heading--with-spacing: Additional spacing for title
      - container container--large: Responsive container sizing
      - data-cc-animate: JavaScript animation trigger
      - h2: Semantic heading level for section structure
      - view_all_page: Optional link to full FAQ page
      - faq.view_all: Localized text for view all link
    {% endcomment %}
    {% if section.settings.title != blank %}
      <div class="section-heading section-heading--with-spacing container container--large"
           data-cc-animate>
        <h2 class="h2">{{ section.settings.title | escape }}</h2>

        {% if section.settings.view_all_page %}
          <a data-cc-animate-click class="view-all-link" href="{{ section.settings.view_all_page }}">
            {{ 'faq.view_all' | t }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% comment %}
      =============================================================================
      ACCORDION CONTENT AREA
      =============================================================================
      Main accordion content container with product integration
      - container container--large: Responsive container for accordion items
      - data-cc-animate: JavaScript animation trigger for content
      - id="faqs-product": Unique identifier for product-specific FAQs
      - product: Current product object for product-specific content
    {% endcomment %}
    <div class="container container--large" data-cc-animate id="faqs-product">
      

      {% if product != blank %}
        {% assign product_type = product.type | handleize %}

        {% if product.type == 'House Hoodie' %}
          {% assign product_type = 'House Hoodies' | handleize %}
        {% endif %}
        {% if product.type == 'JamTee' %}
          {% assign product_type = 'JamTees' | handleize %}
        {% endif %}

        

        {%- assign product_type_collection = collections[product_type] -%}

        {% assign handle_pack = collections[product_type].metafields.custom.collection_pack.value.handle %}
        {% assign handle_five_pack = collections[product_type].metafields.custom.five_pack_collection.value.handle %}

        {% assign has_single_variation = product.metafields.custom.single_product_type %}
        {% assign has_5_pack_variation = product.metafields.custom.parent_single_collection_5_reference_ %}

        {% if has_single_variation != blank or has_5_pack_variation != blank %}
          {% if has_single_variation != blank and handle_pack != blank %}
            {%- assign product_type_collection = collections[handle_pack] -%}
          {% elsif has_5_pack_variation != blank and handle_five_pack != blank %}
            {%- assign product_type_collection = collections[handle_five_pack] -%}
          {% endif %}
        {% endif %}

        <script>
          var isShowMetaobject = {{ section.settings.show_metaobject_faqs }};
        </script>
        {% if section.settings.show_metaobject_faqs == true %}

          {% assign isCustom = false %}
          {% for product in product_type_collection.products %}
            {% for question in product.metafields.custom.faqs_questions.value %}
              {% assign isCustom = true %}
              {% assign text = question.answers | metafield_tag %}
              {%- render "accordion", first_item_open: false, item1_title: question.question, item1_content: text, id_accordion: product.id -%}
            {% endfor %}
          {% endfor %}
          {% for question in product_type_collection.metafields.custom.faqs_questions.value %}
            {% assign isCustom = true %}
            {% assign text = question.answers | metafield_tag %}
            {%- render "accordion", first_item_open: false, item1_title: question.question, item1_content: text, id_accordion: "general" -%}
          {% endfor %}

          {% unless isCustom %}
            <script>
              isShowMetaobject = false;
            </script>
          {% endunless %}


          {% if product.metafields.custom.faqs_questions.value != blank %}
            {% for question in product.metafields.custom.faqs_questions.value %}
              {% assign text = question.answers | metafield_tag %}
              {%- render "accordion", first_item_open: false, item1_title: question.question, item1_content: text -%}
            {% endfor %}
          {% elsif product_type_collection.metafields.custom.faqs_questions.value != blank %}
            {% for question in product_type_collection.metafields.custom.faqs_questions.value %}
              {% assign text = question.answers | metafield_tag %}
              {%- render "accordion", first_item_open: false, item1_title: question.question, item1_content: text -%}
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              <div {{ block.shopify_attributes }}>
                {% capture accordion_title %}
                  {% if block.settings.icon != "none" %}
                    {% render 'icon', icon: block.settings.icon %}
                  {% endif %}
                  {{ block.settings.title }}
                {% endcapture %}
                {%- render "accordion", first_item_open: block.settings.open, item1_title: accordion_title, item1_content: block.settings.text -%}            
              </div>
            {% endfor %}
        {% endif %}  
        {% else %}
          {% for block in section.blocks %}
            <div {{ block.shopify_attributes }}>
              {% capture accordion_title %}
                {% if block.settings.icon != "none" %}
                  {% render 'icon', icon: block.settings.icon %}
                {% endif %}
                {{ block.settings.title }}
              {% endcapture %}
    
              {%- render "accordion", first_item_open: block.settings.open, item1_title: accordion_title, item1_content: block.settings.text -%}              
            </div>
          {% endfor %}
        {% endif %}  
      {% endif %}
      

    </div>
  </div>
</div>


